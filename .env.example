# ─────────────────────────────────────────────────────────────────────────────
# StyleUp environment configuration
# Copy to .env.local for development, or provide via your host's secret manager.
# Never commit real secrets — only this example file is tracked.
# ─────────────────────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Used by migration script (Project Settings → Database → Connection string)
SUPABASE_DB_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# Stripe (Dashboard → Developers → API keys). Connect must be enabled.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Platform commission as a fraction taken from the base service price (0.20 = 20% top tier)
STRIPE_PLATFORM_FEE_RATE=0.20

# Transactional email — Resend (https://resend.com). Optional in dev; emails
# are logged to the console when RESEND_API_KEY is absent.
RESEND_API_KEY=
EMAIL_FROM="StyleUp <bookings@styleup.example>"

# Security
# Comma-separated list of admin emails auto-granted the admin role on first login.
ADMIN_EMAILS=
# Requests-per-minute ceiling for sensitive API routes (per IP).
RATE_LIMIT_PER_MINUTE=60
